# Razorpay Test Mode API Credentials (Required for Phase 1+)
# Must begin with 'rzp_test_'
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/merchant_policy_agent

# LLM Provider Configuration (openrouter | gemini | gnani_evon)
LLM_PROVIDER=openrouter

# OpenRouter Configuration (Primary: Gemma 4 31B Free)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash

# Gnani Evon Configuration (Indic Foundation MoE)
EVON_API_KEY=your_evon_api_key_here
EVON_BASE_URL=https://api.vachana.ai
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# WhatsApp Business Platform / Cloud API Configuration
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_sender_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here
WHATSAPP_VERIFY_TOKEN=vastram_growth_agent_verify_2026
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_TEST_MERCHANT_PHONE=+919113960498
WHATSAPP_DEFAULT_MERCHANT_ID=merch_atlas_travel
WHATSAPP_API_VERSION=v21.0

# Twilio WhatsApp Sandbox Alternative Configuration (Instant Hackathon Mode)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Gnani AI Configuration (Prisma STT, Timbre TTS & Agent Builder)
GNANI_AGENT_ID=7bd15e5ff5a7411db02665f468d3353a
GNANI_SPEECH_API_KEY=your_gnani_speech_api_key_here
GNANI_PLATFORM_API_KEY=your_gnani_agent_builder_platform_key_here
GNANI_SPEECH_BASE_URL=https://api.vachana.ai
GNANI_PLATFORM_BASE_URL=https://api.inya.ai/platform
GNANI_WEBHOOK_SECRET=your_secure_shared_webhook_secret
GNANI_API_KEY=your_gnani_speech_api_key_here
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_STT_DEFAULT_LANG=indic-auto
GNANI_TTS_DEFAULT_LANG=kn
GNANI_USE_LOCAL_MOCK=false
